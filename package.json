{
  "name": "pos-ui-app",
  "private": true,
  "version": "0.1.25",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build:web": "tsc && vite build",
    "prepare:bundle": "rm -rf bundle && mkdir -p bundle && unzip -q -o ${POS_UI_BUNDLE:-../pos.pos-ui/artifacts/pos-ui-bundle.zip} -d bundle",
    "preview": "vite preview",
    "dev": "tauri dev",
    "build": "yarn prepare:bundle && tauri build",
    "build:android": "tauri android build --aab true",
    "build:ios": "tauri ios build",
    "build:macos": "tauri build --bundles dmg",
    "build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-sql": "^2.3.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
