{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Indyz POS",
  "version": "0.1.43",
  "identifier": "com.indyz.ai.pos",
  "build": {
    "beforeDevCommand": "node scripts/serve-bundle.mjs",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../bundle"
  },
  "app": {
    "windows": [
      {
        "title": "Indyz POS",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "indyzai-pos"
          ],
          "host": "auth",
          "pathPrefix": [
            "/callback"
          ]
        },
        {
          "scheme": [
            "https"
          ],
          "host": "auth.indyzai.com",
          "pathPrefix": [
            "/tauri/callback"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "indyzai-pos"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.macOS.plist"
    },
    "iOS": {
      "developmentTeam": "$APPLE_TEAM_ID"
    }
  }
}
